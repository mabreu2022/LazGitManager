object LazGitRevertForm: TLazGitRevertForm
  Left = 380
  Height = 490
  Top = 200
  Width = 730
  BorderStyle = bsDialog
  Caption = 'Reverter / Voltar para Commit Anterior'
  ClientHeight = 490
  ClientWidth = 730
  OnCreate = FormCreate
  Position = poScreenCenter
  LCLVersion = '3.0.0.0'
  object PanelTop: TPanel
    Left = 0
    Height = 32
    Top = 0
    Width = 730
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 32
    ClientWidth = 730
    TabOrder = 0
    object lblPrompt: TLabel
      Left = 10
      Height = 15
      Top = 8
      Width = 432
      Caption = 'Selecione no histórico o ponto (commit) para o qual deseja voltar o projeto:'
      Font.Style = [fsBold]
      ParentColor = False
      ParentFont = False
    end
  end
  object lvCommits: TListView
    Left = 0
    Height = 298
    Top = 32
    Width = 730
    Align = alClient
    Columns = <    
      item
        Caption = 'Hash'
        Width = 85
      end    
      item
        Caption = 'Data'
        Width = 100
      end    
      item
        Caption = 'Autor'
        Width = 130
      end    
      item
        Caption = 'Mensagem de Commit'
        Width = 380
      end>
    ReadOnly = True
    RowSelect = True
    TabOrder = 1
    ViewStyle = vsReport
    OnDblClick = lvCommitsDblClick
  end
  object PanelBottom: TPanel
    Left = 0
    Height = 160
    Top = 330
    Width = 730
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 160
    ClientWidth = 730
    TabOrder = 2
    object rgMode: TRadioGroup
      Left = 8
      Height = 95
      Top = 4
      Width = 714
      Anchors = [akTop, akLeft, akRight]
      AutoFill = True
      Caption = ' Modo de Operação '
      ChildSizing.LeftRightSpacing = 6
      ChildSizing.EnlargeHorizontal = crsHomogenousChildResize
      ChildSizing.EnlargeVertical = crsHomogenousChildResize
      ChildSizing.ShrinkHorizontal = crsScaleChilds
      ChildSizing.ShrinkVertical = crsScaleChilds
      ChildSizing.Layout = cclLeftToRightThenTopToBottom
      ChildSizing.ControlsPerLine = 1
      ClientHeight = 75
      ClientWidth = 710
      ItemIndex = 0
      Items.Strings = (
        '1. Reset Hard: Voltar para este commit e DESCARTAR alterações posteriores dos arquivos'
        '2. Reset Soft: Mover histórico para este commit, mas MANTER alterações nos arquivos'
        '3. Git Revert: Criar um novo commit invertendo as alterações feitas neste commit'
      )
      TabOrder = 0
    end
    object PanelButtons: TPanel
      Left = 0
      Height = 55
      Top = 105
      Width = 730
      Align = alBottom
      BevelOuter = bvNone
      ClientHeight = 55
      ClientWidth = 730
      TabOrder = 1
      object lblWarning: TLabel
        Left = 10
        Height = 15
        Top = 18
        Width = 360
        Caption = 'Dica: Dê duplo clique no commit desejado para reverter rapidamente.'
        Font.Color = clGray
        ParentColor = False
        ParentFont = False
      end
      object btnConfirm: TButton
        Left = 470
        Height = 30
        Top = 10
        Width = 145
        Anchors = [akTop, akRight]
        Caption = 'Confirmar Reversão'
        Default = True
        Font.Style = [fsBold]
        OnClick = btnConfirmClick
        ParentFont = False
        TabOrder = 0
      end
      object btnCancel: TButton
        Left = 625
        Height = 30
        Top = 10
        Width = 95
        Anchors = [akTop, akRight]
        Cancel = True
        Caption = 'Cancelar'
        ModalResult = 2
        TabOrder = 1
      end
    end
  end
end
